{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/demo-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Telegram": {
    "BotToken": ""
  },
  "OpenRouter": {
    "ApiKey": "",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "DataCollection": "deny",
    "DefaultModel": "openai/gpt-4o-mini",
    "ImageModel": "qwen/qwen-image-3-pro"
  },
  "Langfuse": {
    "PublicKey": "",
    "SecretKey": "",
    "Host": ""
  },
  "Pipeline": {
    "Referencias": {
      "MaxCharsPorArquivo": 4000
    }
  },
  "PreFlight": {
    "TimeoutMinutosPendencia": 15,
    "MaxRodadasPerguntas": 2
  },
  "Seguranca": {
    "AnonimizarDados": true,
    "MaxMensagensPorMinuto": 5
  },
  "GrafanaLoki": {
    "Endpoint": "",
    "LoginId": "",
    "Password": ""
  }
}
