{
  "colunas": ["titulo", "hero"],
  "sortear_ordem": true,
  "requer_hero": true,
  "clip_path_padrao": "clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 7px) 100%, 0 calc(100% - 34px));",
  "clip_path_invertido": "clip-path: polygon(0 0, 100% 0, 100% calc(100% - 34px), 7px 100%, 0 calc(100% - 8px));",
  "gradiente_angulo": "135deg",
  "por_fase": {
    "pos-compra": {
      "fundo": "hero"
    }
  }
}
