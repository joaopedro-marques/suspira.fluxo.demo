# Telegram Bot
Telegram__BotToken=seu_token_aqui

# OpenRouter API
OpenRouter__ApiKey=sua_chave_aqui
OpenRouter__BaseUrl=https://openrouter.ai/api/v1
OpenRouter__DataCollection=deny
OpenRouter__DefaultModel=openai/gpt-4o-mini
OpenRouter__ImageModel=qwen/qwen-image-3-pro
OpenRouter__VisionModel=qwen/qwen2.5-vl-72b-instruct
OpenRouter__FallbackModels=deepseek/deepseek-v3.2,qwen/qwen3.7-plus,openai/gpt-4o-mini
OpenRouter__ImageFallbackModels=
OpenRouter__MaxRetriesHttp=5
OpenRouter__BackoffBaseSegundos=5
OpenRouter__BackoffMaxSegundos=60
OpenRouter__Backoff429BaseSegundos=2
OpenRouter__Backoff429MaxSegundos=30

# Langfuse (Observabilidade)
Langfuse__PublicKey=pk-lf-...
Langfuse__SecretKey=sk-lf-...
Langfuse__Host=https://cloud.langfuse.com

# Seguranca
Seguranca__AnonimizarDados=true
Seguranca__MaxMensagensPorMinuto=5

# Grafana Cloud Loki (Observabilidade de logs - https://grafana.com/products/cloud/)
GrafanaLoki__Endpoint=https://logs-prod-012.grafana.net
GrafanaLoki__LoginId=seu-user-id
GrafanaLoki__Password=sua-api-key
